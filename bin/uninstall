#!/bin/bash
# Remove what install created, and optionally the runtime data under
# ~/.local/share/t3-instances. Instance data directories are never touched.
#
# usage: uninstall [--apps] [--runtime]
#   no flags   same as --apps
#   --apps     delete the launcher apps
#   --runtime  delete the shadow homes and the state dir; only safe when no
#              instance is running, and it throws away each instance's UI state
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../config.sh"

remove_apps=false
[ $# -eq 0 ] && remove_apps=true
for arg in "$@"; do
  case "$arg" in
    --apps) remove_apps=true ;;
    --runtime) ;;
    *)
      echo "usage: uninstall [--apps] [--runtime]" >&2
      exit 2
      ;;
  esac
done

if $remove_apps; then
  for name in "${INSTANCES[@]}"; do
    app="$(instance_app "$name")"
    if [ -d "$app" ]; then
      rm -rf "$app"
      echo "removed $app"
    fi
  done
fi

for arg in "$@"; do
  if [ "$arg" = --runtime ] && [ -d "$RUNTIME_DIR" ]; then
    rm -rf "$RUNTIME_DIR"
    echo "removed $RUNTIME_DIR"
  fi
done

echo "done"
