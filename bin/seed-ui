#!/bin/bash
# Carry the current T3 Code's client state into the instance homes, and make
# each home's provider environments safe for the shadow HOME.
#
# Three things do not travel with a seeded or moved home on their own:
#   - the UI state that lives in the Electron user data under the shadow HOME
#     (theme selection, layout, drafts — localStorage),
#   - the client settings files a server-only home never had (the work home
#     ran headless, so it has no client-settings.json or desktop-settings.json),
#   - provider subprocesses inherit HOME from the app, which is the shadow
#     home; they get the real HOME so agent work lands in the usual places.
#
# Client settings are filled in only when the instance has none yet; later
# per-instance changes win. The UI state is copied wholesale, so run this while
# the instance is stopped and expect its layout and theme to reset to whatever
# the current T3 Code shows.
#
# usage: seed-ui [personal|work]     default: both
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../config.sh"

NAME="${1:-}"
case "$NAME" in
  "" | personal | work) ;;
  *)
    echo "usage: seed-ui [personal|work]" >&2
    exit 2
    ;;
esac

# The current T3 Code: one app's UI state, and the home whose client settings
# are the ones the user actually set.
UI_SOURCE="$REAL_HOME/Library/Application Support/t3code"
SETTINGS_SOURCE="$(instance_home personal)/userdata"

CLIENT_FILES="client-settings.json desktop-settings.json clerk-tokens.json"

names="$NAME"
if [ -z "$names" ]; then names="personal work"; fi

for name in $names; do
  home="$(instance_home "$name")"
  shadow="$SHADOW_ROOT/$name"
  userdata="$home/userdata"

  if [ ! -d "$userdata" ]; then
    echo "no userdata in $home — seed or move the home first" >&2
    exit 1
  fi
  if instance_running "$name"; then
    echo "$name is running — quit it before seeding its UI state" >&2
    exit 1
  fi

  # Provider environments must not see the shadow HOME.
  HOME_VALUE="$REAL_HOME" python3 - "$userdata/settings.json" <<'PY'
import json, os, sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(0)
data = json.loads(path.read_text())
changed = False
for instance in data.get("providerInstances", {}).values():
    env = instance.setdefault("environment", [])
    if any(e.get("name") == "HOME" for e in env):
        continue
    env.append({"name": "HOME", "value": os.environ["HOME_VALUE"], "sensitive": False})
    changed = True
if changed:
    path.write_text(json.dumps(data, indent=2) + "\n")
    print(f"  {path}: provider env HOME -> {os.environ['HOME_VALUE']}")
PY

  # A headless home has no client settings; start from the current T3 Code's.
  for file in $CLIENT_FILES; do
    if [ -e "$userdata/$file" ]; then
      continue
    fi
    if [ -e "$SETTINGS_SOURCE/$file" ]; then
      cp -p "$SETTINGS_SOURCE/$file" "$userdata/$file"
      echo "  $name: $file <- $SETTINGS_SOURCE/$file"
    fi
  done

  # UI state (theme among it) lives in the Electron user data, not in userdata.
  if [ ! -d "$UI_SOURCE/Local Storage" ]; then
    echo "  $name: no Local Storage in $UI_SOURCE — UI state not copied" >&2
    continue
  fi
  if lsof "$UI_SOURCE/Local Storage/leveldb/LOCK" >/dev/null 2>&1; then
    echo "  $name: $UI_SOURCE is in use — copying its UI state anyway, it may be slightly stale" >&2
  fi
  target="$shadow/Library/Application Support/t3code"
  rm -rf "$target/Local Storage"
  mkdir -p "$target"
  cp -Rp "$UI_SOURCE/Local Storage" "$target/Local Storage"
  echo "  $name: Local Storage <- $UI_SOURCE/Local Storage"
done

echo "done"
