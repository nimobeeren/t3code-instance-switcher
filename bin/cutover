#!/bin/bash
# One-shot cutover to the daily layout. Run it from Terminal when T3 Code can
# go down for a few minutes. It quits the apps, stops the work service, drops
# the login item, moves ~/.t3 to ~/.t3-personal, repairs the paths that move
# breaks, seeds both instances from the current T3 Code's settings, sets the
# themes, prints the devbox work pairing URL, and relaunches both apps.
#
# Left to you, in the apps it opens: the two connection steps and a turn in
# each instance. The prompts at the end list them again.
#
# usage: cutover
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../config.sh"

LIVE_HOME="$HOME/.t3"
DAILY_PERSONAL_HOME="$HOME/.t3-personal"

if [ "$MODE" != trial ]; then
  echo "config.sh is not MODE=trial — already cut over?" >&2
  exit 2
fi
if [ ! -d "$LIVE_HOME/userdata" ]; then
  echo "no $LIVE_HOME/userdata — nothing to move" >&2
  exit 2
fi
if [ -e "$DAILY_PERSONAL_HOME" ]; then
  echo "$DAILY_PERSONAL_HOME already exists — move it away first" >&2
  exit 2
fi

echo "This quits T3 Code, stops the work service and moves $LIVE_HOME."
echo "Let any running turn finish first. Press Enter to continue, Ctrl-C to abort."
read -r

# Without this T3 Code recreates ~/.t3 at the next login.
if /usr/bin/osascript -e 'tell application "System Events" to delete login item "T3 Code (Alpha)"' >/dev/null 2>&1; then
  echo "removed the T3 Code login item"
else
  echo "could not remove the login item — turn it off in System Settings -> General -> Login Items" >&2
fi

quit_apps() {
  local id attempt
  for id in codes.t3.instance.personal codes.t3.instance.work com.t3tools.t3code; do
    /usr/bin/osascript -e "tell application id \"$id\" to quit" >/dev/null 2>&1 || true
  done
  for attempt in 1 2 3 4 5 6; do
    /usr/bin/pgrep -f 'Contents/MacOS/T3 Code' >/dev/null 2>&1 || return 0
    sleep 2
  done
  /usr/bin/pkill -TERM -f 'Contents/MacOS/T3 Code' >/dev/null 2>&1 || true
  for attempt in 1 2 3 4 5; do
    /usr/bin/pgrep -f 'Contents/MacOS/T3 Code' >/dev/null 2>&1 || return 0
    sleep 2
  done
  echo "T3 Code is still running — quit it yourself and rerun this script" >&2
  exit 1
}
quit_apps
echo "quit T3 Code"

if launchctl bootout "gui/$(id -u)/com.t3tools.t3code.service" >/dev/null 2>&1; then
  echo "stopped the work service (plist kept for rollback)"
else
  echo "work service was not running"
fi

holders="$(lsof +D "$LIVE_HOME" 2>/dev/null || true)"
if [ -n "$holders" ]; then
  echo "$LIVE_HOME is still in use:" >&2
  echo "$holders" >&2
  exit 1
fi

mv "$LIVE_HOME" "$DAILY_PERSONAL_HOME"
echo "moved $LIVE_HOME -> $DAILY_PERSONAL_HOME"
"$BIN_DIR/repair-paths" "$DAILY_PERSONAL_HOME" "$LIVE_HOME"

sed -i '' 's/^MODE=trial$/MODE=daily/' "$BIN_DIR/../config.sh"
. "$BIN_DIR/../config.sh"
echo "config.sh: MODE=$MODE"

"$BIN_DIR/install"
"$BIN_DIR/seed-ui"

if npx t3@latest theme set --base-dir "$DAILY_PERSONAL_HOME" iris; then
  echo "personal theme: iris (purple)"
else
  echo "could not set the personal theme — rerun: npx t3@latest theme set --base-dir $DAILY_PERSONAL_HOME iris" >&2
fi
if npx t3@latest theme set --base-dir "$HOME/.t3-work" "$BIN_DIR/../themes/yew.json"; then
  echo "work theme: yew (dark green)"
else
  echo "could not set the work theme — rerun: npx t3@latest theme set --base-dir $HOME/.t3-work $BIN_DIR/../themes/yew.json" >&2
fi

echo ""
echo "devbox work pairing URL — paste it in the work instance under"
echo "Settings -> Connections -> Add environment:"
if ! ssh devbox '~/.local/bin/t3 pair --base-dir ~/.t3-work --label devbox-work'; then
  echo "  (ssh devbox failed — run it later: ssh devbox '~/.local/bin/t3 pair --base-dir ~/.t3-work --label devbox-work')"
fi

echo ""
"$BIN_DIR/status"
/usr/bin/open "$(instance_app personal)" "$(instance_app work)"

cat <<'NEXT'

Both apps are starting. What is left:

  1. Personal app: Settings -> Connections -> remove "MAC0133 work" and "devbox work".
  2. Work app: Settings -> Connections -> Add environment, paste the pairing URL above.
  3. Run a turn in each instance to verify.

Then: ./bin/uninstall --trial
NEXT
