#!/bin/bash
# What the instances are and whether they run.
#
# usage: status
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$BIN_DIR/../config.sh"

for name in "${INSTANCES[@]}"; do
  state="stopped"
  if instance_running "$name"; then
    state="running (pid $(instance_pid "$name"))"
  fi
  app="app missing"
  if [ -d "$(instance_app "$name")" ]; then
    app="app installed"
  fi
  home="$(instance_home "$name")"
  data="no data"
  [ -d "$home" ] && data="data present"
  printf '%-12s %-22s port %-5s %-12s %-12s %s\n' \
    "$name" "$state" "$(instance_port "$name")" "$app" "$data" "$home"
done
echo "last touched: $(cat "$STATE_DIR/last" 2>/dev/null || echo -)"
