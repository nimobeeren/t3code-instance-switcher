#!/bin/bash
# Fix up the paths a T3 home leaves behind when it is moved (for example
# mv ~/.t3 ~/.t3-personal): thread rows point at worktrees under the old home,
# and the git worktrees in the home point back at their main repositories.
# Rewrite the thread rows and let git repair both sides of each worktree link.
# Runs in both directions, so the move back is repaired the same way.
#
# usage: repair-paths <new-home> <old-home>
set -euo pipefail

NEW_HOME="${1:-}"
OLD_HOME="${2:-}"
if [ -z "$NEW_HOME" ] || [ -z "$OLD_HOME" ]; then
  echo "usage: repair-paths <new-home> <old-home>" >&2
  exit 2
fi

DB="$NEW_HOME/userdata/state.sqlite"

if [ ! -f "$DB" ]; then
  echo "no state.sqlite in $NEW_HOME/userdata" >&2
  exit 1
fi

if [ "$OLD_HOME" = "$NEW_HOME" ]; then
  echo "old and new home are both $NEW_HOME — nothing to repair" >&2
  exit 2
fi

cp -p "$DB" "$DB.bak-$(date +%Y%m%d-%H%M%S)"
echo "backed up $DB"

OLD_WORKTREES="$OLD_HOME/worktrees/"
NEW_WORKTREES="$NEW_HOME/worktrees/"
export OLD_WORKTREES NEW_WORKTREES

python3 - "$DB" <<'PY'
import os, sqlite3, sys

db = sys.argv[1]
old, new = os.environ["OLD_WORKTREES"], os.environ["NEW_WORKTREES"]
con = sqlite3.connect(db)
rows = con.execute(
    "SELECT COUNT(*) FROM projection_threads WHERE worktree_path LIKE ?",
    (old + "%",),
).fetchone()[0]
if rows:
    con.execute(
        "UPDATE projection_threads SET worktree_path = replace(worktree_path, ?, ?)"
        " WHERE worktree_path LIKE ?",
        (old, new, old + "%"),
    )
    print(f"rewrote worktree_path on {rows} thread(s) to {new}")
payloads = con.execute(
    "SELECT COUNT(*) FROM provider_session_runtime"
    " WHERE runtime_payload_json LIKE ? OR resume_cursor_json LIKE ?",
    ("%" + old + "%", "%" + old + "%"),
).fetchone()[0]
if payloads:
    con.execute(
        "UPDATE provider_session_runtime SET"
        " runtime_payload_json = replace(runtime_payload_json, ?, ?),"
        " resume_cursor_json = replace(resume_cursor_json, ?, ?)"
        " WHERE runtime_payload_json LIKE ? OR resume_cursor_json LIKE ?",
        (old, new, old, new, "%" + old + "%", "%" + old + "%"),
    )
    print(f"rewrote session runtime payloads on {payloads} row(s)")
con.commit()
con.close()
PY

# OpenCode stores the directory of every session in its own databases, and
# that is where a resumed session goes looking for its worktree.
for db in "$HOME"/.local/share/opencode/*.db; do
  [ -e "$db" ] || continue
  python3 - "$db" <<'PY'
import os, sqlite3, sys

db = sys.argv[1]
old, new = os.environ["OLD_WORKTREES"], os.environ["NEW_WORKTREES"]
con = sqlite3.connect(db, timeout=15)
if not con.execute(
    "SELECT 1 FROM sqlite_master WHERE type='table' AND name='session'"
).fetchone():
    con.close()
    raise SystemExit(0)

def stale(table, column="directory"):
    return con.execute(
        f"SELECT COUNT(*) FROM {table} WHERE {column} LIKE ?", (old + "%",)
    ).fetchone()[0]

if not any((
    stale("session"),
    stale("project_directory"),
    stale("workspace"),
    stale("project", "worktree"),
)):
    con.close()
    raise SystemExit(0)

backup = sqlite3.connect(f"{db}.bak-repair")
con.backup(backup)
backup.close()

# project_directory is unique per (project_id, directory): drop rows whose
# rewritten pair is already there, then rewrite the rest.
con.execute(
    "DELETE FROM project_directory WHERE directory LIKE ?"
    " AND EXISTS (SELECT 1 FROM project_directory p WHERE p.project_id = project_directory.project_id"
    " AND p.directory = replace(project_directory.directory, ?, ?))",
    (old + "%", old, new),
)
for table in ("project_directory", "session", "workspace"):
    con.execute(
        f"UPDATE {table} SET directory = replace(directory, ?, ?)"
        " WHERE directory LIKE ?",
        (old, new, old + "%"),
    )
con.execute(
    "UPDATE project SET worktree = replace(worktree, ?, ?) WHERE worktree LIKE ?",
    (old, new, old + "%"),
)
con.commit()
print(f"{db}: session directories moved to {new}")
con.close()
PY
done

repaired=0
for worktree in "$NEW_HOME"/worktrees/*/*/; do
  [ -e "$worktree/.git" ] || continue
  common="$(git -C "$worktree" rev-parse --git-common-dir 2>/dev/null)" || {
    echo "skipped $worktree (not a git worktree)" >&2
    continue
  }
  if git -C "$common" worktree repair "$worktree" >/dev/null 2>&1; then
    echo "repaired $worktree"
    repaired=$((repaired + 1))
  else
    echo "could not repair $worktree" >&2
  fi
done
echo "git-repaired $repaired worktree(s)"
